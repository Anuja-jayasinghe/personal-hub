# Copy to .env.local on each computer and fill in. .env.local is git-ignored; never commit real values.

# Supabase session pooler (IPv4-safe), project "personal-hub". Format:
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Used by the Supabase CLI and kept for reference. Same password as in DATABASE_URL.
SUPABASE_DB_PASSWORD=<db-password>

# Supabase project URL and SECRET key (server-side only, DECISIONS C19/C34). Never use a NEXT_PUBLIC_ prefix.
# Fetch the key on a new computer with:  supabase projects api-keys --reveal   (type "secret", name "default")
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<hidden>

# ---- Login (Phase 4.1, DECISIONS C61): Clerk ----------------------------------------------------
# Create your own Clerk application at https://clerk.com (development instance is fine locally),
# then copy its two keys here from the dashboard's "API keys" page. Never paste them anywhere else.
# The publishable key is public by design; the secret key is not: never commit it or print it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<from the Clerk dashboard>
CLERK_SECRET_KEY=sk_test_<from the Clerk dashboard>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# End-to-end tests (pnpm e2e, C121): a separate PRODUCTION Clerk secret key (named e2e-local in the dashboard)
# so Playwright can create and sign in a TEST account on the live site. Optional; never commit or print it.
E2E_CLERK_SECRET_KEY=sk_live_<a separate key from the Clerk dashboard>
# E2E_BASE_URL=https://hub.anujajay.com

# Who may use the hub: your email address (comma separated if more than one). This list is the real
# gate: a stranger who signs up still gets nothing. Empty means nobody is allowed.
ALLOWED_EMAILS=<your email address>


# Daily notification run (C127, C139): Vercel Cron sends this as a bearer token to /api/notify. At least 32 random
# characters; set on Vercel (sensitive). Optional locally.
CRON_SECRET=<random, at least 32 characters>

# iPhone push (N.3, C140): a VAPID key pair from web-push's generateVAPIDKeys(). The public key goes to the browser
# (public by design); the private key signs every push: secret, server only, never commit or print it. The subject
# is the hub's own address, never a personal email. If any of the three is missing, push stays "not set up".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<87-character base64url public key>
VAPID_PRIVATE_KEY=<43-character base64url private key>
VAPID_SUBJECT=https://hub.anujajay.com

# Plan-ahead emails (N.2, C141): a Resend API key with "sending access" only, restricted to the domain
# mail.hub.anujajay.com, and the owner's delivery address (a tagged Gmail address). Both secret; set on Vercel
# (sensitive, Production only). Optional locally: without them the email channel stays a dry run.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
